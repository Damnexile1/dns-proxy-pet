# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=dnsproxy
DB_PASSWORD=changeme
DB_NAME=dnsproxy
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# DNS Server
DNS_PORT=53
DNS_UPSTREAM_SERVERS=1.1.1.1:53,8.8.8.8:53
DNS_CACHE_TTL=300

# Proxy Server
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
PROXY_HOST=0.0.0.0

# API Server
API_PORT=8000
API_HOST=0.0.0.0
JWT_SECRET=changeme_jwt_secret_key_here
JWT_EXPIRATION=24h

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_IDS=123456789

# Payment (YooKassa)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret

# Application
APP_ENV=development
LOG_LEVEL=debug
