# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /build

# Install dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the DNS server
RUN CGO_ENABLED=0 GOOS=linux go build -o dns-server ./cmd/dns-server

# Final stage
FROM alpine:latest

WORKDIR /app

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

# Copy binary from builder
COPY --from=builder /build/dns-server .

# Expose DNS port
EXPOSE 53/udp 53/tcp

CMD ["./dns-server"]
